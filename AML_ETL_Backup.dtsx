    <DTS:Executable
      DTS:refId="Package\SQL_Check_Gold_Alerts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{D90F7CA6-A2E9-4E2B-BC0E-F92FBE56727C}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Check_Gold_Alerts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="SELECT&#xA;    COUNT(DISTINCT RawTransactionID) AS TotalHighValueAlerts,&#xA;    COUNT(DISTINCT CASE&#xA;        WHEN IsLaundering = 1 THEN RawTransactionID&#xA;    END) AS KnownLaunderingCasesFlagged&#xA;FROM gold.AML_Transaction_Alerts;"
          SQLTask:ResultType="ResultSetType_SingleRow" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask">
          <SQLTask:ResultBinding
            SQLTask:ResultName="0"
            SQLTask:DtsVariableName="User::TotalHighValueAlerts" />
          <SQLTask:ResultBinding
            SQLTask:ResultName="1"
            SQLTask:DtsVariableName="User::KnownLaunderingCasesFlagged" />
        </SQLTask:SqlTaskData>
      </DTS:ObjectData>
    </DTS:Executable>
