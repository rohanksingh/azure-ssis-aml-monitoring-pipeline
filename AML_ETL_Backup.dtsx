        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="IF SCHEMA_ID('bronze') IS NULL&#xA;    EXEC('CREATE SCHEMA bronze');&#xA;&#xA;IF OBJECT_ID('bronze.AML_Transactions_Raw', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE bronze.AML_Transactions_Raw&#xA;    (&#xA;        RawTransactionID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;        [Timestamp] NVARCHAR(255) NULL,&#xA;        [From Bank] NVARCHAR(255) NULL,&#xA;        [Account] NVARCHAR(255) NULL,&#xA;        [To Bank] NVARCHAR(255) NULL,&#xA;        [Account.1] NVARCHAR(255) NULL,&#xA;        [Amount Received] NVARCHAR(255) NULL,&#xA;        [Receiving Currency] NVARCHAR(255) NULL,&#xA;        [Amount Paid] NVARCHAR(255) NULL,&#xA;        [Payment Currency] NVARCHAR(255) NULL,&#xA;        [Payment Format] NVARCHAR(255) NULL,&#xA;        [Is Laundering] NVARCHAR(255) NULL,&#xA;        LoadTimestamp DATETIME2 DEFAULT SYSUTCDATETIME()&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Create_AML_Gold_Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{FD14BB5B-1413-4BDA-B196-4DBCB5CC345A}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Create_AML_Gold_Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="IF SCHEMA_ID('gold') IS NULL&#xA;    EXEC('CREATE SCHEMA gold');&#xA;&#xA;IF OBJECT_ID('gold.AML_Transaction_Alerts', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE gold.AML_Transaction_Alerts&#xA;    (&#xA;        AlertID BIGINT IDENTITY(1,1) PRIMARY KEY,&#xA;        RawTransactionID BIGINT NOT NULL,&#xA;        TransactionDateTime DATETIME2 NULL,&#xA;        FromBank NVARCHAR(255) NULL,&#xA;        FromAccount NVARCHAR(255) NULL,&#xA;        ToBank NVARCHAR(255) NULL,&#xA;        ToAccount NVARCHAR(255) NULL,&#xA;        AmountPaid DECIMAL(20,2) NULL,&#xA;        PaymentCurrency NVARCHAR(50) NULL,&#xA;        AlertRule NVARCHAR(100) NOT NULL,&#xA;        AlertSeverity NVARCHAR(20) NOT NULL,&#xA;        IsLaundering BIT NULL,&#xA;        AlertCreatedAt DATETIME2&#xA;            NOT NULL DEFAULT SYSUTCDATETIME()&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Create_AML_Silver_Table"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{8C4A5EEF-8345-4426-A473-3765AE8830D5}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Create_AML_Silver_Table"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="IF SCHEMA_ID('silver') IS NULL&#xA;    EXEC('CREATE SCHEMA silver');&#xA;&#xA;IF OBJECT_ID('silver.AML_Transactions_Clean', 'U') IS NULL&#xA;BEGIN&#xA;    CREATE TABLE silver.AML_Transactions_Clean&#xA;    (&#xA;        RawTransactionID BIGINT NOT NULL PRIMARY KEY,&#xA;        TransactionDateTime DATETIME2 NULL,&#xA;        FromBank NVARCHAR(255) NULL,&#xA;        FromAccount NVARCHAR(255) NULL,&#xA;        ToBank NVARCHAR(255) NULL,&#xA;        ToAccount NVARCHAR(255) NULL,&#xA;        AmountReceived DECIMAL(20,2) NULL,&#xA;        ReceivingCurrency NVARCHAR(50) NULL,&#xA;        AmountPaid DECIMAL(20,2) NULL,&#xA;        PaymentCurrency NVARCHAR(50) NULL,&#xA;        PaymentFormat NVARCHAR(100) NULL,&#xA;        IsLaundering BIT NULL,&#xA;        SilverLoadTimestamp DATETIME2&#xA;            NOT NULL DEFAULT SYSUTCDATETIME()&#xA;    );&#xA;END;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Gold_Credit_Card_Alerts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{9009834A-0D8E-4500-97D7-F4BB06C151B2}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Gold_Credit_Card_Alerts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;DELETE FROM gold.AML_Transaction_Alerts&#xA;WHERE AlertRule = 'CREDIT_CARD_HIGH_AMOUNT';&#xA;&#xA;INSERT INTO gold.AML_Transaction_Alerts&#xA;(&#xA;    RawTransactionID,&#xA;    TransactionDateTime,&#xA;    FromBank,&#xA;    FromAccount,&#xA;    ToBank,&#xA;    ToAccount,&#xA;    AmountPaid,&#xA;    PaymentCurrency,&#xA;    AlertRule,&#xA;    AlertSeverity,&#xA;    IsLaundering&#xA;)&#xA;SELECT&#xA;    RawTransactionID,&#xA;    TransactionDateTime,&#xA;    FromBank,&#xA;    FromAccount,&#xA;    ToBank,&#xA;    ToAccount,&#xA;    AmountPaid,&#xA;    PaymentCurrency,&#xA;    'CREDIT_CARD_HIGH_AMOUNT',&#xA;    'HIGH',&#xA;    IsLaundering&#xA;FROM silver.AML_Transactions_Clean&#xA;WHERE PaymentFormat = 'Credit Card'&#xA;  AND AmountPaid &gt; 29000;&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Gold_High_Value_Alerts"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{61745EC3-869D-4A04-AED8-CE664DD1672E}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Gold_High_Value_Alerts"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;DELETE FROM gold.AML_Transaction_Alerts&#xA;WHERE AlertRule = 'HIGH_VALUE_TRANSACTION';&#xA;&#xA;INSERT INTO gold.AML_Transaction_Alerts&#xA;(&#xA;    RawTransactionID,&#xA;    TransactionDateTime,&#xA;    FromBank,&#xA;    FromAccount,&#xA;    ToBank,&#xA;    ToAccount,&#xA;    AmountPaid,&#xA;    PaymentCurrency,&#xA;    AlertRule,&#xA;    AlertSeverity,&#xA;    IsLaundering&#xA;)&#xA;SELECT&#xA;    RawTransactionID,&#xA;    TransactionDateTime,&#xA;    FromBank,&#xA;    FromAccount,&#xA;    ToBank,&#xA;    ToAccount,&#xA;    AmountPaid,&#xA;    PaymentCurrency,&#xA;    'HIGH_VALUE_TRANSACTION',&#xA;    'HIGH',&#xA;    IsLaundering&#xA;FROM silver.AML_Transactions_Clean&#xA;WHERE AmountPaid &gt;= 100000;&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
    <DTS:Executable
      DTS:refId="Package\SQL_Load_AML_Silver"
      DTS:CreationName="Microsoft.ExecuteSQLTask"
      DTS:Description="Execute SQL Task"
      DTS:DTSID="{DADBC225-49D3-48BF-A33F-2E43D011D88D}"
      DTS:ExecutableType="Microsoft.ExecuteSQLTask"
      DTS:LocaleID="-1"
      DTS:ObjectName="SQL_Load_AML_Silver"
      DTS:TaskContact="Execute SQL Task; Microsoft Corporation; SQL Server 2025; © 2025 Microsoft Corporation; All Rights Reserved;http://www.microsoft.com/sql/support/default.asp;1"
      DTS:ThreadHint="0">
      <DTS:Variables />
      <DTS:ObjectData>
        <SQLTask:SqlTaskData
          SQLTask:Connection="{A57417DE-185C-4A13-8008-701E478213A0}"
          SQLTask:SqlStatementSource="SET XACT_ABORT ON;&#xA;&#xA;BEGIN TRANSACTION;&#xA;&#xA;DELETE FROM silver.AML_Transactions_Clean;&#xA;&#xA;INSERT INTO silver.AML_Transactions_Clean&#xA;(&#xA;    RawTransactionID,&#xA;    TransactionDateTime,&#xA;    FromBank,&#xA;    FromAccount,&#xA;    ToBank,&#xA;    ToAccount,&#xA;    AmountReceived,&#xA;    ReceivingCurrency,&#xA;    AmountPaid,&#xA;    PaymentCurrency,&#xA;    PaymentFormat,&#xA;    IsLaundering&#xA;)&#xA;SELECT&#xA;    RawTransactionID,&#xA;   TRY_CONVERT(DATETIME2, TRIM([Timestamp]), 101),&#xA;    NULLIF(TRIM([From Bank]), ''),&#xA;    NULLIF(TRIM([Account]), ''),&#xA;    NULLIF(TRIM([To Bank]), ''),&#xA;    NULLIF(TRIM([Account.1]), ''),&#xA;    TRY_CONVERT(DECIMAL(20,2), [Amount Received]),&#xA;    NULLIF(TRIM([Receiving Currency]), ''),&#xA;    TRY_CONVERT(DECIMAL(20,2), [Amount Paid]),&#xA;    NULLIF(TRIM([Payment Currency]), ''),&#xA;    NULLIF(TRIM([Payment Format]), ''),&#xA;    TRY_CONVERT(BIT, TRIM([Is Laundering]))&#xA;FROM bronze.AML_Transactions_Raw;&#xA;&#xA;COMMIT TRANSACTION;" xmlns:SQLTask="www.microsoft.com/sqlserver/dts/tasks/sqltask" />
      </DTS:ObjectData>
    </DTS:Executable>
  </DTS:Executables>
